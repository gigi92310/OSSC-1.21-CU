+int erase_userdata(uint8_t entry) {
+    uint32_t flash_addr;
+
+    /* Only profile slots 0..MAX_PROFILE may be erased here.
+     * INIT_CONFIG_SLOT is deliberately protected. */
+    if (entry > MAX_PROFILE) {
+        printf("invalid profile entry\n");
+        return -1;
+    }
+
+    flash_addr = flashctrl_dev.flash_size - (16-entry)*FLASH_SECTOR_SIZE;
+
+    /* Erasing the sector removes the USRDATA signature.  read_userdata()
+     * will therefore report the slot as empty on the next dry-run/read. */
+    flash_write_protect(&flashctrl_dev, 0);
+    flash_sector_erase(&flashctrl_dev, flash_addr);
+    flash_write_protect(&flashctrl_dev, 1);
+
+    printf("userdata profile entry %u erased\n", entry);
+    return 0;
+}
+
+
+/* Copy one internal profile slot exactly as stored in flash.  The source is
+ * validated before destination erase.  INIT_CONFIG slot is never accepted. */
+int copy_userdata(uint8_t src, uint8_t dst) {
+    uint32_t src_addr, dst_addr, offs;
+    ude_hdr hdr;
+    extern char tmpbuf[SD_BLK_SIZE];
+
+    if ((src > MAX_PROFILE) || (dst > MAX_PROFILE))
+        return -1;
+    if (src == dst)
+        return 0;
+
+    src_addr = flashctrl_dev.flash_size - (16-src)*FLASH_SECTOR_SIZE;
+    dst_addr = flashctrl_dev.flash_size - (16-dst)*FLASH_SECTOR_SIZE;
+    memcpy(&hdr, (uint32_t*)(INTEL_GENERIC_SERIAL_FLASH_INTERFACE_TOP_0_AVL_MEM_BASE + src_addr), sizeof(hdr));
+    if (strncmp(hdr.userdata_key, "USRDATA", 8))
+        return -2;
+
+    flash_write_protect(&flashctrl_dev, 0);
+    flash_sector_erase(&flashctrl_dev, dst_addr);
+    for (offs=0; offs<FLASH_SECTOR_SIZE; offs+=SD_BLK_SIZE) {
+        memcpy(tmpbuf, (uint32_t*)(INTEL_GENERIC_SERIAL_FLASH_INTERFACE_TOP_0_AVL_MEM_BASE + src_addr + offs), SD_BLK_SIZE);
+        memcpy((uint32_t*)(INTEL_GENERIC_SERIAL_FLASH_INTERFACE_TOP_0_AVL_MEM_BASE + dst_addr + offs), tmpbuf, SD_BLK_SIZE);
+    }
+    flash_write_protect(&flashctrl_dev, 1);
+    return 0;
+}
+
+/* Full raw backup format: 16-byte header followed by the sixteen 64 KiB
+ * userdata sectors (profiles 0..14 + INIT_CONFIG).  A CRC is verified before
+ * restore starts, so a damaged/incomplete SD file never triggers flash erase. */
+typedef struct {
+    char magic[8];
+    uint32_t data_len;
+    uint32_t data_crc;
+} __attribute__((packed)) userdata_backup_hdr;
+
+#define USERDATA_BACKUP_FILE "ossc_bak.bin"
+#define USERDATA_BACKUP_LEN  (16UL*FLASH_SECTOR_SIZE)
+
+int backup_userdata_all() {
+    FIL f;
+    userdata_backup_hdr bh;
+    unsigned int bw;
+    uint32_t entry, offs, addr, crc=0;
+    int retval=0;
+    extern char tmpbuf[SD_BLK_SIZE];
+
+    if (!sdcard_dev.mount && file_mount() != 0)
+        return -1;
+    f_chdir("/");
+    if (f_open(&f, USERDATA_BACKUP_FILE, FA_WRITE|FA_CREATE_ALWAYS) != F_OK)
+        return -2;
+
+    memset(&bh, 0, sizeof(bh));
+    strlcpy(bh.magic, "OSSCBK1", sizeof(bh.magic));
+    bh.data_len = USERDATA_BACKUP_LEN;
+    if ((f_write(&f, &bh, sizeof(bh), &bw) != F_OK) || (bw != sizeof(bh))) {
+        retval = -3;
+        goto backup_close;
+    }
+
+    for (entry=0; entry<16; entry++) {
+        addr = flashctrl_dev.flash_size - (16-entry)*FLASH_SECTOR_SIZE;
+        for (offs=0; offs<FLASH_SECTOR_SIZE; offs+=SD_BLK_SIZE) {
+            memcpy(tmpbuf, (uint32_t*)(INTEL_GENERIC_SERIAL_FLASH_INTERFACE_TOP_0_AVL_MEM_BASE + addr + offs), SD_BLK_SIZE);
+            crc = crc32((unsigned char*)tmpbuf, SD_BLK_SIZE, (entry == 0 && offs == 0));
+            if ((f_write(&f, tmpbuf, SD_BLK_SIZE, &bw) != F_OK) || (bw != SD_BLK_SIZE)) {
+                retval = -4;
+                goto backup_close;
+            }
+        }
+    }
+
+    bh.data_crc = crc;
+    if ((f_lseek(&f, 0) != F_OK) || (f_write(&f, &bh, sizeof(bh), &bw) != F_OK) || (bw != sizeof(bh)))
+        retval = -5;
+
+backup_close:
+    file_close(&f);
+    return retval;
+}
+
+int restore_userdata_all() {
+    FIL f;
+    userdata_backup_hdr bh;
+    unsigned int br;
+    uint32_t entry, offs, addr, crc=0;
+    int retval=0;
+    extern char tmpbuf[SD_BLK_SIZE];
+
+    if (!sdcard_dev.mount && file_mount() != 0)
+        return -1;
+    f_chdir("/");
+    if (file_open(&f, USERDATA_BACKUP_FILE) != F_OK)
+        return -2;
+    if ((f_read(&f, &bh, sizeof(bh), &br) != F_OK) || (br != sizeof(bh)) ||
+        strncmp(bh.magic, "OSSCBK1", 7) || (bh.data_len != USERDATA_BACKUP_LEN)) {
+        retval = -3;
+        goto restore_close;
+    }
+
+    /* Pass 1: verify the complete backup before touching flash. */
+    for (entry=0; entry<16; entry++) {
+        for (offs=0; offs<FLASH_SECTOR_SIZE; offs+=SD_BLK_SIZE) {
+            if ((f_read(&f, tmpbuf, SD_BLK_SIZE, &br) != F_OK) || (br != SD_BLK_SIZE)) {
+                retval = -4;
+                goto restore_close;
+            }
+            crc = crc32((unsigned char*)tmpbuf, SD_BLK_SIZE, (entry == 0 && offs == 0));
+        }
+    }
+    if (crc != bh.data_crc) {
+        retval = -5;
+        goto restore_close;
+    }
+
+    if (f_lseek(&f, sizeof(bh)) != F_OK) {
+        retval = -6;
+        goto restore_close;
+    }
+
+    /* Pass 2: exact sector restore. */
+    flash_write_protect(&flashctrl_dev, 0);
+    for (entry=0; entry<16; entry++) {
+        addr = flashctrl_dev.flash_size - (16-entry)*FLASH_SECTOR_SIZE;
+        flash_sector_erase(&flashctrl_dev, addr);
+        for (offs=0; offs<FLASH_SECTOR_SIZE; offs+=SD_BLK_SIZE) {
+            if ((f_read(&f, tmpbuf, SD_BLK_SIZE, &br) != F_OK) || (br != SD_BLK_SIZE)) {
+                flash_write_protect(&flashctrl_dev, 1);
+                retval = -7;
+                goto restore_close;
+            }
+            memcpy((uint32_t*)(INTEL_GENERIC_SERIAL_FLASH_INTERFACE_TOP_0_AVL_MEM_BASE + addr + offs), tmpbuf, SD_BLK_SIZE);
+        }
+    }
+    flash_write_protect(&flashctrl_dev, 1);
+
+restore_close:
+    file_close(&f);
+    return retval;
+}

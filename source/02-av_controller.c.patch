+/* Select an optional profile from the measured input class.  15 means no
+ * mapping.  This deliberately uses sync geometry only: modes that share the
+ * same sync (for example Atari ST low/medium) remain one class. */
+static void auto_profile_mode() {
+    uint8_t p = INIT_CONFIG_SLOT;
+    uint32_t v_hz_x100;
+
+    if (!ts.mode_profile_enable || !cm.sync_active || !cm.pcnt_field)
+        return;
+
+    v_hz_x100 = (100*TVP_EXTCLK_HZ)/cm.pcnt_field;
+
+    if (!cm.progressive) {
+        p = (cm.totlines > 700) ? ts.mode_profile_1080i : ts.mode_profile_480i;
+    } else if (cm.totlines <= 360) {
+        p = ts.mode_profile_240p;
+    } else if ((cm.totlines <= 450) || ((cm.totlines <= 550) && (v_hz_x100 >= 6500))) {
+        /* Includes 384/400p and ~70 Hz computer modes such as Atari ST HIGH
+         * (typically reported around 501p / 71 Hz by the OSSC). */
+        p = ts.mode_profile_400p;
+    } else if (cm.totlines <= 625) {
+        p = ts.mode_profile_480p;
+    } else if (cm.totlines <= 800) {
+        p = ts.mode_profile_720p;
+    } else {
+        p = ts.mode_profile_1080p;
+    }
+
+    if ((p <= MAX_PROFILE) && (p != profile_sel) && (read_userdata(p, 0) == 0))
+        profile_sel = p;
+}
